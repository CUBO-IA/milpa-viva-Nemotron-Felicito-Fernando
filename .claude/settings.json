{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(git config --global *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(gh pr create *)",
      "Bash(gh repo edit *)",
      "Bash(gh api *collaborators*)",
      "Read(./.env)"
    ]
  }
}
